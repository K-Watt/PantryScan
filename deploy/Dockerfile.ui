# PantryScan UI — Vite build served by nginx, which also proxies /api to the API
# container. Building with VITE_API_URL=/api keeps the host out of the bundle and
# avoids cross-origin requests entirely.
FROM node:22-alpine AS build
WORKDIR /src
COPY ui-react/package.json ui-react/package-lock.json ./
RUN npm ci
COPY ui-react/ ./
ENV VITE_API_URL=/api
RUN npm run build

FROM nginx:alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Copy to .env and fill in. .env is gitignored - never commit real secrets.

# Postgres password for the 'pantryscan' role. Generate one, e.g.:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 28
PG_PASSWORD=change-me

# Host directory for the Postgres data volume.
# On a btrfs filesystem, disable copy-on-write on this directory BEFORE first
# use or the database will fragment badly:  sudo chattr +C <dir>
PGDATA_DIR=./pgdata
